{
  "name": "@seed-fe/request",
  "version": "1.2.0-alpha.3",
  "description": "A powerful and flexible HTTP request library based on Axios",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "check": "biome check --write",
    "format": "biome format --write",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deps:check": "ncu",
    "deps:update": "ncu -u -t minor",
    "deps:interactive": "ncu -i"
  },
  "keywords": [
    "axios",
    "http",
    "http-client",
    "request",
    "typescript",
    "browser",
    "node"
  ],
  "author": "xianghongai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xianghongai/seed-fe-request.git"
  },
  "bugs": {
    "url": "https://github.com/xianghongai/seed-fe-request/issues"
  },
  "homepage": "https://github.com/xianghongai/seed-fe-request#readme",
  "packageManager": "pnpm@10.22.0",
  "dependencies": {
    "@seed-fe/logger": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "axios": "^1.13.2",
    "npm-check-updates": "^19.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "axios": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
